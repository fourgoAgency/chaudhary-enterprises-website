# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for canonical URLs, sitemap, Open Graph and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Verified sender, e.g. "Chaudhary Enterprises <no-reply@chaudharyenterprisesllc.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives contact-form and bulk-quote enquiries
CONTACT_TO_EMAIL=
# Resend audience for newsletter sign-ups (optional)
RESEND_AUDIENCE_ID=
