# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP for order emails (see lib/mailer.ts).
# Use the SMTP details from your email provider, e.g. Google Workspace (smtp.gmail.com, app password),
# Microsoft 365 (smtp.office365.com, port 587, SMTP_SECURE=false), Zoho, or your hosting's mail server.
SMTP_HOST=
# 465 with SMTP_SECURE=true (SSL), or 587 with SMTP_SECURE=false (STARTTLS)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@chaudharyenterprisesllc.com
SMTP_PASS=

# Optional. Defaults: sender = "Chaudhary Enterprises" <admin@chaudharyenterprisesllc.com>,
# orders delivered to admin@chaudharyenterprisesllc.com
MAIL_FROM=
ORDERS_TO_EMAIL=
