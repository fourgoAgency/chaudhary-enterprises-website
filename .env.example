# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Verified sender, e.g. "Chaudhary Enterprises <no-reply@chaudharyenterprisesllc.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives bulk-quote enquiries
CONTACT_TO_EMAIL=
